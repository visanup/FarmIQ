generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["analytics"]
}

model MinuteFeatures {
  bucket     DateTime @db.Timestamptz(6)
  tenantId   String   @map("tenant_id")
  deviceId   String   @map("device_id")
  sensorId   String   @default("") @map("sensor_id")
  metric     String
  tags       Json     @default("{}")
  tagsHash   String   @map("tags_hash")
  valueCount BigInt   @default(0) @map("value_count")
  valueSum   Float    @default(0) @map("value_sum")
  valueMin   Float    @map("value_min")
  valueMax   Float    @map("value_max")
  valueSumsq Float    @default(0) @map("value_sumsq")

  @@id([bucket, tenantId, deviceId, metric, sensorId, tagsHash], map: "minute_features_pk")
  @@index([bucket], map: "ix_minute_features_brin_bucket", type: Brin)
  @@index([tenantId, deviceId, bucket(sort: Desc)], map: "ix_minute_features_device_time")
  @@index([tenantId, metric, bucket(sort: Desc)], map: "ix_minute_features_metric_time")
  @@index([tags], map: "ix_minute_features_tags_gin", type: Gin)
  @@index([bucket(sort: Desc)])
  @@map("minute_features")
  @@schema("analytics")
}

model DimDevice {
  tenantId  String   @map("tenant_id")
  deviceId  String   @map("device_id")
  farmId    String?  @map("farm_id")
  houseId   String?  @map("house_id")
  type      String?
  status    String?
  name      String?
  model     String?
  vendor    String?
  serialNo  String?  @map("serial_no")
  meta      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, deviceId])
  @@index([meta], map: "gin_dim_device_meta", type: Gin)
  @@index([tenantId, farmId], map: "ix_dim_device_farm")
  @@index([tenantId, houseId], map: "ix_dim_device_house")
  @@map("dim_device")
  @@schema("analytics")
}

model DimFarm {
  tenantId  String   @map("tenant_id")
  farmId    String   @map("farm_id")
  name      String?
  lat       Float?
  lon       Float?
  region    String?
  meta      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, farmId])
  @@index([meta], map: "gin_dim_farm_meta", type: Gin)
  @@map("dim_farm")
  @@schema("analytics")
}

model DimHouse {
  tenantId  String   @map("tenant_id")
  houseId   String   @map("house_id")
  farmId    String   @map("farm_id")
  name      String?
  capacity  Int?
  type      String?
  meta      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, houseId])
  @@index([meta], map: "gin_dim_house_meta", type: Gin)
  @@index([tenantId, farmId], map: "ix_dim_house_farm")
  @@map("dim_house")
  @@schema("analytics")
}

model DimFlock {
  tenantId   String    @map("tenant_id")
  flockId    String    @map("flock_id")
  houseId    String    @map("house_id")
  farmId     String?   @map("farm_id")
  breed      String?
  sex        String?
  population Int?
  startDate  DateTime? @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  meta       Json      @default("{}")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, flockId])
  @@index([meta], map: "gin_dim_flock_meta", type: Gin)
  @@index([tenantId, farmId], map: "ix_dim_flock_farm")
  @@index([tenantId, houseId], map: "ix_dim_flock_house")
  @@map("dim_flock")
  @@schema("analytics")
}

model DimCustomer {
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  name       String?
  email      String?
  phone      String?
  address    String?
  meta       Json     @default("{}")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, customerId])
  @@index([meta], map: "gin_dim_customer_meta", type: Gin)
  @@map("dim_customer")
  @@schema("analytics")
}

model DimAnimalType {
  tenantId   String   @map("tenant_id")
  animalTypeId String @map("animal_type_id")
  name       String?
  category   String?
  description String?
  meta       Json     @default("{}")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, animalTypeId])
  @@index([meta], map: "gin_dim_animal_type_meta", type: Gin)
  @@map("dim_animal_type")
  @@schema("analytics")
}

model DimBreed {
  tenantId   String   @map("tenant_id")
  breedId    String   @map("breed_id")
  animalTypeId String @map("animal_type_id")
  name       String?
  code       String?
  description String?
  characteristics Json @default("{}")
  meta       Json     @default("{}")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, breedId])
  @@index([meta], map: "gin_dim_breed_meta", type: Gin)
  @@index([tenantId, animalTypeId], map: "ix_dim_breed_animal_type")
  @@map("dim_breed")
  @@schema("analytics")
}

model AnalyticsAgg {
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(6)
  windowS     Int      @map("window_s")
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  sensorId    String   @map("sensor_id")
  metric      String
  countN      BigInt   @default(0) @map("count_n")
  sumVal      Float?   @map("sum_val")
  avgVal      Float?   @map("avg_val")
  minVal      Float?   @map("min_val")
  maxVal      Float?   @map("max_val")
  stddevVal   Float?   @map("stddev_val")
  p95Val      Float?   @map("p95_val")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, farmId, houseId, metric, windowS, bucketStart], map: "analytics_agg_pk")
  @@unique([tenantId, farmId, houseId, sensorId, metric, windowS, bucketStart], map: "analytics_agg_conflict_idx")
  @@index([bucketStart(sort: Desc)])
  @@map("analytics_agg")
  @@schema("analytics")
}

model AnalyticsEvent {
  time       DateTime @db.Timestamptz(6)
  tenantId   String   @map("tenant_id")
  domain     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  eventType  String   @map("event_type")
  value      Float?
  unit       String?
  severity   Int?     @db.SmallInt
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, domain, entityType, entityId, eventType, time], map: "analytics_event_pk")
  @@index([time(sort: Desc)])
  @@index([domain, entityType, entityId, eventType, time(sort: Desc)], map: "idx_event_lookup")
  @@map("analytics_event")
  @@schema("analytics")
}

model AnalyticsEventRollup {
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(6)
  windowS     Int      @map("window_s")
  tenantId    String   @map("tenant_id")
  domain      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  eventType   String   @map("event_type")
  countN      BigInt   @default(0) @map("count_n")
  sumVal      Float?   @map("sum_val")
  avgVal      Float?   @map("avg_val")
  minVal      Float?   @map("min_val")
  maxVal      Float?   @map("max_val")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, domain, entityType, entityId, eventType, windowS, bucketStart], map: "analytics_event_rollup_pk")
  @@index([bucketStart(sort: Desc)])
  @@index([domain, entityType, entityId, eventType, windowS, bucketStart(sort: Desc)], map: "idx_event_rollup_lookup")
  @@map("analytics_event_rollup")
  @@schema("analytics")
}

model AnalyticsKpi {
  period      String   @map("period") // Changed from Unsupported("kpi_period") to String
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  sensorId    String   @map("sensor_id")
  metric      String
  n           BigInt   @default(0)
  meanVal     Float?   @map("mean_val")
  stddevVal   Float?   @map("stddev_val")
  cp          Float?
  cpk         Float?
  pp          Float?
  ppk         Float?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, farmId, houseId, sensorId, metric, period, periodStart], map: "analytics_kpi_pk")
  @@index([periodStart(sort: Desc)])
  @@index([tenantId, farmId, houseId, metric, period, periodStart(sort: Desc)], map: "idx_kpi_lookup")
  @@map("analytics_kpi")
  @@schema("analytics")
}

model AnalyticsAnomaly {
  time      DateTime @db.Timestamptz(6)
  tenantId  String   @map("tenant_id")
  farmId    String   @map("farm_id")
  houseId   String   @map("house_id")
  sensorId  String?  @map("sensor_id")
  metric    String
  ruleCode  String   @map("rule_code")
  severity  Int      @default(1) @db.SmallInt
  value     Float
  cl        Float?
  ucl       Float?
  lcl       Float?
  zscore    Float?
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, farmId, houseId, metric, time, ruleCode], map: "analytics_anomaly_pk")
  @@index([time(sort: Desc)])
  @@index([tenantId, farmId, houseId, metric, time(sort: Desc)], map: "idx_anomaly_lookup")
  @@map("analytics_anomaly")
  @@schema("analytics")
}

model AnalyticsAlerts {
  id             Int       @id @default(autoincrement())
  type           String
  message        String
  metadata       Json?
  isResolved     Boolean?  @default(false) @map("is_resolved")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  tenantId       String    @map("tenant_id")
  farmId         String    @map("farm_id")
  deviceId       String    @map("device_id")
  metric         String
  value          Float
  alertTime      DateTime  @map("alert_time") @db.Timestamptz(6)
  severity       String
  alertType      String    @map("alert_type")
  additionalInfo Json?     @map("additional_info")

  @@index([metric, alertTime], map: "idx_analytics_alerts_metric_time")
  @@index([isResolved, createdAt], map: "idx_analytics_alerts_resolved")
  @@index([severity, createdAt], map: "idx_analytics_alerts_severity")
  @@index([tenantId, farmId, deviceId], map: "idx_analytics_alerts_tenant_farm_device")
  @@index([alertType, createdAt], map: "idx_analytics_alerts_type")
  @@map("analytics_alerts")
  @@schema("analytics")
}

model analytics_spec_limits {
  tenant_id  String
  farm_id    String
  house_id   String
  sensor_id  String?
  metric     String
  period     String   @map("period")
  cl         Float?
  ucl        Float?
  lcl        Float?
  method     String?
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@id([tenant_id, farm_id, house_id, metric, period], map: "analytics_spec_limits_pk")
  @@index([tenant_id, farm_id, house_id, metric], map: "idx_spec_lookup")
  @@schema("analytics")
}

model feature_publish_log {
  id           BigInt   @id @default(autoincrement())
  tenant_id    String
  bucket       DateTime @db.Timestamptz(6)
  device_id    String
  sensor_id    String   @default("")
  metric       String
  tags_hash    String
  published_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenant_id, bucket(sort: Desc)], map: "ix_publog_bucket")
  @@schema("analytics")
}

model metric_catalog {
  metric       String  @id
  display_name String?
  unit         String?
  rollup       String  @default("avg")
  decimals     Int?    @default(2)
  lower_bound  Float?
  upper_bound  Float?
  tags_schema  Json?   @default("{}")
  description  String?

  @@schema("analytics")
}

model minute_watermark {
  tenant_id String   @id
  watermark DateTime @db.Timestamptz(6)

  @@schema("analytics")
}

model worker_checkpoints {
  group_id     String
  topic        String
  partition_id Int
  last_offset  BigInt   @default(0)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  @@id([group_id, topic, partition_id], map: "worker_checkpoints_pk")
  @@schema("analytics")
}

// ===========================================
// FCR (Feed Conversion Ratio) Models
// ===========================================
model FcrCalculation {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  flockId     String   @map("flock_id")
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  totalFeed   Float    @map("total_feed") // Total feed consumed (kg)
  totalWeight Float    @map("total_weight") // Total weight gain (kg)
  fcrValue    Float    @map("fcr_value") // FCR = feed/weight
  population  Int?     // Number of animals
  breed       String?  // Animal breed
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, farmId, houseId, flockId, periodStart, periodEnd], map: "fcr_calculations_conflict_idx")
  @@index([tenantId, farmId, houseId, flockId])
  @@index([periodStart, periodEnd])
  @@index([fcrValue])
  @@map("fcr_calculations")
  @@schema("analytics")
}

model FcrTarget {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String?  @map("house_id")
  breed       String?  // Target breed (null = all breeds)
  targetFcr   Float    @map("target_fcr")
  minFcr      Float?   @map("min_fcr")
  maxFcr      Float?   @map("max_fcr")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, farmId, houseId])
  @@index([breed])
  @@index([isActive])
  @@map("fcr_targets")
  @@schema("analytics")
}

// ===========================================
// Size Distribution Models
// ===========================================
model SizeDistribution {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  flockId     String   @map("flock_id")
  measurementDate DateTime @map("measurement_date") @db.Timestamptz(6)
  weightClass WeightClass @map("weight_class")
  minWeight   Float    @map("min_weight")
  maxWeight   Float    @map("max_weight")
  count       Int      // Number of animals in this weight class
  percentage  Float?   // Percentage of total population
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, farmId, houseId, flockId])
  @@index([measurementDate])
  @@index([weightClass])
  @@map("size_distributions")
  @@schema("analytics")
}

// ===========================================
// Prediction Models
// ===========================================
model PredictionModel {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  modelName   String   @map("model_name")
  modelType   PredictionType @map("model_type")
  version     String   @default("1.0.0")
  status      ModelStatus @default(ACTIVE)
  config      Json     @default("{}") // Model configuration
  metrics     Json?    @default("{}") // Model performance metrics
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, modelType])
  @@index([status])
  @@index([isActive])
  @@map("prediction_models")
  @@schema("analytics")
}

model Prediction {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  modelId     String   @map("model_id")
  farmId      String   @map("farm_id")
  houseId     String?  @map("house_id")
  flockId     String?  @map("flock_id")
  deviceId    String?  @map("device_id")
  predictionType PredictionType @map("prediction_type")
  targetDate  DateTime @map("target_date") @db.Timestamptz(6)
  predictedValue Float @map("predicted_value")
  confidence  Float?   // Confidence score (0-1)
  actualValue Float?   @map("actual_value") // Actual value when available
  accuracy    Float?   // Accuracy when actual value is available
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, modelId])
  @@index([predictionType, targetDate])
  @@index([farmId, houseId, flockId])
  @@map("predictions")
  @@schema("analytics")
}

// ===========================================
// Health Analytics Models
// ===========================================
model HealthMetrics {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  flockId     String   @map("flock_id")
  measurementDate DateTime @map("measurement_date") @db.Timestamptz(6)
  mortalityRate Float?  @map("mortality_rate") // Deaths per 1000 animals
  morbidityRate Float?  @map("morbidity_rate") // Sick animals per 1000
  avgWeight   Float?   @map("avg_weight") // Average weight
  feedIntake  Float?   @map("feed_intake") // Daily feed intake
  waterIntake Float?   @map("water_intake") // Daily water intake
  temperature Float?   // Average temperature
  humidity    Float?   // Average humidity
  co2Level    Float?   @map("co2_level")
  nh3Level    Float?   @map("nh3_level")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, farmId, houseId, flockId])
  @@index([measurementDate])
  @@unique([tenantId, farmId, houseId, flockId, measurementDate], map: "health_metrics_conflict_idx")
  @@map("health_metrics")
  @@schema("analytics")
}

// ===========================================
// Production Analytics Models
// ===========================================
model ProductionMetrics {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  flockId     String   @map("flock_id")
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  totalProduction Float @map("total_production") // Total production (eggs, meat, etc.)
  dailyProduction Float @map("daily_production") // Daily average production
  productionRate Float @map("production_rate") // Production per animal
  qualityScore Float? @map("quality_score") // Quality score (0-100)
  efficiency  Float?   // Production efficiency
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, farmId, houseId, flockId, periodStart, periodEnd], map: "production_metrics_conflict_idx")
  @@index([tenantId, farmId, houseId, flockId])
  @@index([periodStart, periodEnd])
  @@map("production_metrics")
  @@schema("analytics")
}

// ===========================================
// Environmental Analytics Models
// ===========================================
model EnvironmentalMetrics {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  farmId      String   @map("farm_id")
  houseId     String   @map("house_id")
  deviceId    String   @map("device_id")
  measurementDate DateTime @map("measurement_date") @db.Timestamptz(6)
  temperature Float?   // Temperature in Celsius
  humidity    Float?   // Humidity percentage
  co2Level    Float?   @map("co2_level") // CO2 level in ppm
  nh3Level    Float?   @map("nh3_level") // NH3 level in ppm
  lightLevel  Float?   @map("light_level") // Light level in lux
  airVelocity Float?   @map("air_velocity") // Air velocity in m/s
  pressure    Float?   // Atmospheric pressure
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, farmId, houseId, deviceId])
  @@index([measurementDate])
  @@map("environmental_metrics")
  @@schema("analytics")
}

// ===========================================
// Analytics Configuration Models
// ===========================================
model AnalyticsConfig {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  configType  ConfigType @map("config_type")
  configKey   String   @map("config_key")
  configValue Json     @map("config_value")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, configType])
  @@index([configKey])
  @@index([isActive])
  @@map("analytics_configs")
  @@schema("analytics")
}

// ===========================================
// Analytics Job Models
// ===========================================
model AnalyticsJob {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  jobType     JobType  @map("job_type")
  status      JobStatus @default(PENDING)
  priority    Int      @default(0)
  config      Json     @default("{}") // Job configuration
  result      Json?    @default("{}") // Job result
  errorMessage String? @map("error_message")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, jobType])
  @@index([status])
  @@index([priority])
  @@map("analytics_jobs")
  @@schema("analytics")
}

// ===========================================
// Enums
// ===========================================
enum PredictionType {
  FCR
  WEIGHT
