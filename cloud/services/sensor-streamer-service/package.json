{
  "name": "@farmiq/sensor-streamer-service",
  "version": "1.0.0",
  "private": true,
  "description": "Sensor data streaming service for FarmIQ",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:setup": "node scripts/setup-database.js",
    "db:timescale": "node scripts/setup-timescale.js",
    "db:cleanup": "node scripts/cleanup-data.js",
    "db:stats": "node scripts/database-stats.js",
    "mock:generate": "node scripts/generate-mock-data.js",
    "mock:comprehensive": "node scripts/generate-comprehensive-mock-data.js",
    "mock:quick": "node scripts/generate-quick-mock-data.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts || echo \"skip\"",
    "setup": "yarn db:generate && yarn db:push && yarn db:timescale",
    "docker:infra:up": "cd ../.. && docker-compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "cd ../.. && docker-compose -f docker-compose.infra.yml down",
    "docker:infra:logs": "cd ../.. && docker-compose -f docker-compose.infra.yml logs -f",
    "docker:apps:up": "cd ../.. && docker-compose -f docker-compose.apps.yml up -d",
    "docker:apps:down": "cd ../.. && docker-compose -f docker-compose.apps.yml down",
    "docker:apps:logs": "cd ../.. && docker-compose -f docker-compose.apps.yml logs -f"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.13.1",
    "@fastify/swagger-ui": "^4.1.0",
    "@prisma/client": "^5.7.1",
    "axios": "^1.7.2",
    "dotenv": "^16.4.1",
    "fastify": "^4.25.2",
    "kafkajs": "^2.2.4",
    "minio": "^8.0.2",
    "mqtt": "^5.10.1",
    "prom-client": "^15.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
