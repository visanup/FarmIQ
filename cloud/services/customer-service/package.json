{
  "name": "@farmiq/customer-service",
  "version": "1.0.0",
  "private": true,
  "description": "Customer Service (Fastify + Prisma + Zod + Swagger)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts || echo \"skip\""
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.13.1",
    "@fastify/swagger-ui": "^4.1.0",
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.4.1",
    "fastify": "^4.25.2",
    "kafkajs": "^2.2.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
