// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core entities
model Farm {
  id          String   @id @default(cuid())
  name        String
  location    String?
  size        Decimal? @db.Decimal(10, 2)
  type        String?  // dairy, poultry, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  houses      House[]
  animals     Animal[]
  devices     Device[]
  operations  OperationRecord[]
  metrics     PerformanceMetric[]
  healthRecords HealthRecord[]
  feedPrograms FeedProgram[]
  waterQuality WaterQuality[]
  welfareIndicators WelfareIndicator[]

  @@map("farms")
  @@schema("data")
}

model House {
  id          String   @id @default(cuid())
  farmId      String
  name        String
  type        String?  // barn, coop, etc.
  capacity    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals     Animal[]
  devices     Device[]
  housingConditions HousingCondition[]

  @@map("houses")
  @@schema("data")
}

model Animal {
  id              String   @id @default(cuid())
  farmId          String
  houseId         String?
  tagNumber       String
  breed           String?
  birthDate       DateTime?
  gender          String?
  weight          Decimal? @db.Decimal(8, 2)
  status          String   @default("active") // active, sold, deceased
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  house           House?   @relation(fields: [houseId], references: [id])
  healthRecords   HealthRecord[]
  performanceMetrics PerformanceMetric[]
  feedIntakes     FeedIntake[]
  geneticFactors  GeneticFactor[]

  @@unique([farmId, tagNumber])
  @@map("animals")
  @@schema("data")
}

model Device {
  id              String   @id @default(cuid())
  farmId          String
  houseId         String?
  deviceTypeId    String
  serialNumber    String
  name            String?
  location        Json?    // Store location as JSON
  isActive        Boolean  @default(true)
  lastSeen        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  house           House?   @relation(fields: [houseId], references: [id])
  deviceType      DeviceType @relation(fields: [deviceTypeId], references: [id])
  deviceGroup     DeviceGroup? @relation(fields: [deviceGroupId], references: [id])
  deviceGroupId   String?
  logs            DeviceLog[]
  statusHistory   DeviceStatusHistory[]
  sensors         Sensor[]

  @@unique([serialNumber])
  @@map("devices")
  @@schema("data")
}

model DeviceType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  category    String?  // sensor, controller, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  devices     Device[]

  @@map("device_types")
  @@schema("data")
}

model DeviceGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  farmId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  devices     Device[]

  @@map("device_groups")
  @@schema("data")
}

model DeviceLog {
  id          String   @id @default(cuid())
  deviceId    String
  level       String   // info, warning, error
  message     String
  data        Json?    // Store additional data as JSON
  timestamp   DateTime @default(now())

  // Relations
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@map("device_logs")
  @@schema("data")
}

model DeviceStatusHistory {
  id          String   @id @default(cuid())
  deviceId    String
  status      String   // online, offline, error, maintenance
  message     String?
  timestamp   DateTime @default(now())

  // Relations
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
  @@map("device_status_history")
  @@schema("data")
}

model Sensor {
  id          String   @id @default(cuid())
  deviceId    String
  type        String   // temperature, humidity, pressure, etc.
  unit        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sensors")
  @@schema("data")
}

// Health and Performance
model HealthRecord {
  id          String   @id @default(cuid())
  animalId    String
  farmId      String
  type        String   // vaccination, treatment, checkup, etc.
  description String?
  date        DateTime
  veterinarian String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([animalId, date])
  @@map("health_records")
  @@schema("data")
}

model PerformanceMetric {
  id          String   @id @default(cuid())
  animalId    String?
  farmId      String
  metric      String   // milk_production, weight_gain, etc.
  value       Decimal  @db.Decimal(10, 4)
  unit        String?
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  animal      Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, metric, date])
  @@map("performance_metrics")
  @@schema("data")
}

// Feed Management
model FeedProgram {
  id          String   @id @default(cuid())
  farmId      String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedBatches FeedBatch[]
  feedIntakes FeedIntake[]

  @@map("feed_programs")
  @@schema("data")
}

model FeedBatch {
  id              String   @id @default(cuid())
  feedProgramId   String
  batchNumber     String
  feedType        String
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String
  supplier        String?
  productionDate  DateTime?
  expiryDate      DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  feedProgram     FeedProgram @relation(fields: [feedProgramId], references: [id], onDelete: Cascade)
  compositions    FeedComposition[]
  assignments     FeedBatchAssign[]

  @@map("feed_batches")
  @@schema("data")
}

model FeedComposition {
  id          String   @id @default(cuid())
  feedBatchId String
  nutrient    String
  percentage  Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  feedBatch   FeedBatch @relation(fields: [feedBatchId], references: [id], onDelete: Cascade)

  @@map("feed_compositions")
  @@schema("data")
}

model FeedIntake {
  id              String   @id @default(cuid())
  animalId        String?
  feedProgramId   String
  feedBatchId     String?
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String
  date            DateTime
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  animal          Animal?     @relation(fields: [animalId], references: [id], onDelete: Cascade)
  feedProgram     FeedProgram @relation(fields: [feedProgramId], references: [id], onDelete: Cascade)

  @@index([animalId, date])
  @@map("feed_intakes")
  @@schema("data")
}

model FeedBatchAssign {
  id          String   @id @default(cuid())
  feedBatchId String
  houseId     String?
  quantity    Decimal  @db.Decimal(10, 2)
  unit        String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  feedBatch   FeedBatch @relation(fields: [feedBatchId], references: [id], onDelete: Cascade)

  @@map("feed_batch_assigns")
  @@schema("data")
}

// Environmental Factors
model ExternalFactor {
  id          String   @id @default(cuid())
  name        String
  type        String   // weather, market, policy, etc.
  description String?
  value       Decimal? @db.Decimal(10, 4)
  unit        String?
  date        DateTime
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, date])
  @@map("external_factors")
  @@schema("data")
}

model EnvFactor {
  id          String   @id @default(cuid())
  farmId      String?
  type        String   // temperature, humidity, air_quality, etc.
  value       Decimal  @db.Decimal(10, 4)
  unit        String?
  location    Json?    // Store location as JSON
  date        DateTime
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([farmId, type, date])
  @@map("env_factors")
  @@schema("data")
}

model GeneticFactor {
  id          String   @id @default(cuid())
  animalId    String
  trait       String
  value       Decimal  @db.Decimal(10, 4)
  unit        String?
  date        DateTime
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  animal      Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId, trait, date])
  @@map("genetic_factors")
  @@schema("data")
}

// Water Quality
model WaterQuality {
  id          String   @id @default(cuid())
  farmId      String
  location    String?
  ph          Decimal? @db.Decimal(4, 2)
  temperature Decimal? @db.Decimal(5, 2)
  turbidity   Decimal? @db.Decimal(8, 2)
  dissolvedOxygen Decimal? @db.Decimal(8, 2)
  notes       String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, date])
  @@map("water_quality")
  @@schema("data")
}

// Housing Conditions
model HousingCondition {
  id          String   @id @default(cuid())
  houseId     String
  temperature Decimal? @db.Decimal(5, 2)
  humidity    Decimal? @db.Decimal(5, 2)
  ventilation Decimal? @db.Decimal(5, 2)
  lighting    Decimal? @db.Decimal(5, 2)
  notes       String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  house       House    @relation(fields: [houseId], references: [id], onDelete: Cascade)

  @@index([houseId, date])
  @@map("housing_conditions")
  @@schema("data")
}

// Welfare Indicators
model WelfareIndicator {
  id          String   @id @default(cuid())
  farmId      String
  animalId    String?
  indicator   String   // behavior, health, environment, etc.
  value       Decimal  @db.Decimal(10, 4)
  unit        String?
  notes       String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, indicator, date])
  @@map("welfare_indicators")
  @@schema("data")
}

// Economic Data
model Economic {
  id          String   @id @default(cuid())
  farmId      String?
  category    String   // revenue, cost, profit, etc.
  subcategory String?  // feed, labor, equipment, etc.
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("THB")
  date        DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([farmId, category, date])
  @@map("economic")
  @@schema("data")
}

// Operations
model OperationRecord {
  id          String   @id @default(cuid())
  farmId      String
  type        String   // feeding, cleaning, maintenance, etc.
  description String?
  startTime   DateTime
  endTime     DateTime?
  operator    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  farm        Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, type, startTime])
  @@map("operation_records")
  @@schema("data")
}

// Subscriptions (if needed for data access)
model Subscription {
  id          String   @id @default(cuid())
  customerId  String
  planId      String
  status      String   // active, inactive, suspended, cancelled
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("subscriptions")
  @@schema("data")
}

