{
  "name": "@farmiq/master-service",
  "version": "1.0.0",
  "private": true,
  "description": "Master data management service for FarmIQ",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:setup": "yarn db:generate && yarn db:push",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts || echo \"skip\"",
    "test": "jest",
    "mock:generate": "node scripts/generate-complete-mockup-v2.js",
    "mock:generate:complete": "node scripts/generate-complete-mockup-v2.js",
    "mock:cleanup": "node scripts/cleanup-all-data.js",
    "mock:check": "node scripts/check-data-status.js",
    "migrate:all": "cd migration && npm run migrate:all",
    "migrate:customers": "cd migration && npm run migrate:customers",
    "migrate:farms": "cd migration && npm run migrate:farms",
    "migrate:devices": "cd migration && npm run migrate:devices",
    "migrate:feeds": "cd migration && npm run migrate:feeds",
    "migrate:formulas": "cd migration && npm run migrate:formulas",
    "migrate:economic": "cd migration && npm run migrate:economic",
    "migrate:external-factors": "cd migration && npm run migrate:external-factors",
    "migrate:validate": "cd migration && npm run validate",
    "migrate:setup": "cd migration && npm install",
    "docker:infra:up": "cd ../.. && docker-compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "cd ../.. && docker-compose -f docker-compose.infra.yml down"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.13.1",
    "@fastify/swagger-ui": "^4.1.0",
    "@prisma/client": "^5.7.1",
    "axios": "^1.7.2",
    "dotenv": "^16.4.1",
    "fastify": "^4.25.2",
    "kafkajs": "^2.2.4",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3",
    "tslib": "^2.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
