# Master Service Database
MASTER_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=master"

# Legacy Service Databases
CUSTOMER_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=customers"
FARM_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=farms"
DEVICE_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=devices"
FEED_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=feeds"
FORMULA_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=formulas"
ECONOMIC_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=economics"
EXTERNAL_FACTOR_DATABASE_URL="postgresql://postgres:password@localhost:5432/sensor_cloud_db?schema=external_factors"

# Migration Settings
MIGRATION_BATCH_SIZE=100
MIGRATION_DELAY_MS=100
MIGRATION_RETRY_ATTEMPTS=3
MIGRATION_RETRY_DELAY_MS=1000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/migration.log

# Validation
VALIDATION_STRICT_MODE=true
VALIDATION_SAMPLE_SIZE=1000

