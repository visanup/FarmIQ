// Images Ingestion Service Prisma Schema
// Uses shared database with separate schema for microservice isolation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["edge_image"]
}

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]   // << เพิ่มบรรทัดนี้
}

// Images Ingestion Service Models
model MediaObject {
  id          String   @id @default(cuid())
  mediaId     String   @unique
  tenantId    String
  farmId      String?
  houseId     String?
  stationId   String?
  sensorId    String?
  bucket      String
  objectKey   String
  fileName    String
  fileSize    BigInt
  mimeType    String
  sha256      String
  width       Int?
  height      Int?
  metadata    Json?
  time        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("media_objects")
  @@schema("edge_image")
  @@index([tenantId, time])
  @@index([bucket, objectKey])
  @@index([mediaId])
}

model ReadingMediaMap {
  id          String   @id @default(cuid())
  mediaId     String
  readingId   String
  deltaMs     Int
  strategy    String
  confidence  Float?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reading_media_map")
  @@schema("edge_image")
  @@index([mediaId])
  @@index([readingId])
  @@unique([mediaId, readingId])
}